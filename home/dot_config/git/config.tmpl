{{- /* Resolve profile data - either from named profile or custom values */ -}}
{{- $name := "" -}}
{{- $email := "" -}}
{{- $signingkey := "" -}}

{{- if eq .profile "custom" -}}
{{-   $name = .github.name -}}
{{-   $email = .github.email -}}
{{-   if hasKey .github "signingkey" -}}
{{-     $signingkey = .github.signingkey -}}
{{-   end -}}
{{- else -}}
{{-   $p := index .profiles .profile -}}
{{-   $name = $p.github.name -}}
{{-   $email = $p.github.email -}}
{{-   if hasKey $p.github "signingkey" -}}
{{-     $signingkey = $p.github.signingkey -}}
{{-   end -}}
{{- end -}}

[user]
	name = {{ $name }}
	email = {{ $email }}
{{- if $signingkey }}
	signingkey = {{ $signingkey }}
{{- end }}

[core]
{{- if eq .chezmoi.os "windows" }}
	autocrlf = true
{{- else }}
	autocrlf = input
{{- end }}
{{- if lookPath "delta" }}
	pager = delta
{{- end }}

[init]
	defaultBranch = main

[status]
	short = true

[pull]
	rebase = false

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
	; GCM's macOS installer runs `git-credential-manager configure`, which
	; rewrites this section as git writes it: helpers first, the empty one
	; with a trailing space, comments last. Any other layout, or `manager`
	; instead of the path, shows up as drift.
{{- else }}
	helper =
	helper = manager
{{- end }}

{{- if $signingkey }}
[gpg]
	format = ssh

[commit]
	gpgsign = true

{{- end }}
[credential "https://dev.azure.com"]
	useHttpPath = true

; TPM clones from https://git::@github.com/... so a missing plugin fails
; instead of prompting. With a helper, git saves that "git" login as a second
; GitHub account, and GCM then asks which account to use on every push. Keep
; it after [credential]: git applies matching sections in file order.
[credential "https://git@github.com"]
	helper =

{{- if lookPath "delta" }}

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	; Theme-derived styles live in per-theme [delta "<theme>"] features (committed
	; by theme-gen, included below). The active one is selected at runtime by
	; DELTA_FEATURES=+$THEME (derived from $THEME in .zshenv); `features` here is
	; the fallback default when DELTA_FEATURES is unset. Structural options above
	; stay in [delta] deliberately — options set directly here override features.
	features = vscode-dark-modern
{{ range $name, $_ := (include "../themes/palette.toml" | fromToml).themes }}
[include]
	path = ~/.config/delta/themes/{{ $name }}.gitconfig
{{- end }}
{{- end }}

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
