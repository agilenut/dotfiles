#!/bin/bash
# Daily recap wrapper invoked by launchd. Runs Claude Code headlessly to
# generate missing recaps (yesterday plus any earlier days the laptop
# missed while asleep) and write them to ~/Documents/recaps/.
set -euo pipefail
umask 077
source "$(dirname "${BASH_SOURCE[0]}")/../lib/dotfiles-lock.sh"

RECAP_DIR="$HOME/Documents/recaps"
LOG_DIR="$HOME/Library/Logs"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/recap"
STATE_FILE="$STATE_DIR/last-day"
mkdir -p "$LOG_DIR" "$STATE_DIR"
# Best-effort — under launchd this script cannot create anything inside
# ~/Documents (see the TCC note below). Claude does have the grant and the
# skill creates the directory itself on first write.
mkdir -p "$RECAP_DIR" 2>/dev/null || true

# Yesterday + next-day helper (BSD on macOS, GNU elsewhere).
if [[ "$(uname)" == "Darwin" ]]; then
  YESTERDAY=$(date -v-1d +%Y-%m-%d)
  next_day() { date -j -f "%Y-%m-%d" -v+1d "$1" +%Y-%m-%d; }
else
  YESTERDAY=$(date -d 'yesterday' +%Y-%m-%d)
  next_day() { date -d "$1 + 1 day" +%Y-%m-%d; }
fi

# Start the day after the last recap we recorded generating; if none, just
# yesterday.
#
# This deliberately does NOT list $RECAP_DIR. Under launchd the responsible
# process for TCC is this bash, which has no Documents access, so a glob of
# ~/Documents/recaps silently expands to nothing — the script would conclude
# no recap exists and regenerate the same day on every hourly fire, forever.
# (Verified: `ls` and `read` on that directory are DENIED under launchd while
# `stat` is not gated, which is why the completion check below still works and
# the log still claimed success.) The state file lives outside any protected
# folder, so it stays readable.
LAST=$(cat "$STATE_FILE" 2>/dev/null || true)
if [[ "$LAST" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  DAY=$(next_day "$LAST")
else
  DAY="$YESTERDAY"
fi

# Nothing to do — exit silently so hourly fires are cheap no-ops.
if [[ "$DAY" > "$YESTERDAY" ]]; then
  exit 0
fi

# Mutex against concurrent fires — the midnight calendar trigger and an
# hourly tick can land near the same minute. The loser exits silently. A
# signal exits, so the run never continues after releasing its lock.
LOCK_DIR="$LOG_DIR/recap-daily.lock"
if ! lock_acquire "$LOCK_DIR"; then
  exit 0
fi
trap 'lock_release "$LOCK_DIR"' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# A running update can upgrade the claude-code cask, replacing the binary
# mid-recap. Skip the hour; the next fire catches up. Checked after taking our
# own lock (topgrade-daily does the same), so when both start at once at least
# one sees the other.
if lock_held "$LOG_DIR/topgrade.lock"; then
  exit 0
fi

# Loop forward through any missing days, up to and including yesterday.
# Bail on the first failure — the state file only advances after a day is
# confirmed written, so the next run retries that day rather than skipping it.
while [[ ! "$DAY" > "$YESTERDAY" ]]; do
  LOG="$LOG_DIR/recap-daily-${DAY}.log"
  OUT="$RECAP_DIR/${DAY}.md"
  (
    set +e
    echo "=== $(date) — recap for $DAY ==="
    claude \
      --print \
      --dangerously-skip-permissions \
      --allowed-tools="Bash,Read,Write,Glob,Grep" \
      "/recap $DAY"
    claude_exit=$?
    if [[ -f "$OUT" ]]; then
      echo "=== $(date) — claude exit $claude_exit, recap written ==="
    else
      echo "=== $(date) — claude exit $claude_exit, FAIL: $OUT not written ==="
    fi
    echo
  ) >>"$LOG" 2>&1
  # -f is a stat, which TCC does not gate, so this check is reliable even
  # though listing or reading the same directory is not.
  if [[ ! -f "$OUT" ]]; then
    exit 1
  fi
  echo "$DAY" >"$STATE_FILE"
  DAY=$(next_day "$DAY")
done
