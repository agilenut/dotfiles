#!/usr/bin/env bash
# -*-mode:sh-*- vim:ft=shell-script
# shellcheck shell=bash

# @raycast.schemaVersion 1
# @raycast.title Refresh Claude Sessions
# @raycast.mode compact
# @raycast.icon ♻️
# @raycast.packageName Claude

# claude-refresh
# =============================================================================
# Restart every claude process running in tmux panes, in place, so each picks
# up a newly installed Claude Code version and resumes its session. Run it
# after `brewup`/`update` bumps the claude-code cask; tmux itself (windows,
# layouts, scrollback, non-claude panes) is untouched.
#
# Per pane whose current command is `claude`:
#   named session  → send C-c C-c to exit, wait for the shell, `claude -r <name>`
#   unnamed        → left running on the old version (nothing to resume by;
#                    matches claude-restore's leave-alone behavior)
#   invoking pane  → skipped, so a claude session asked to run this can't
#                    kill itself mid-refresh
#
# Session names come from the pane title (`<glyph> <name>`), parsed by
# claude_restore_classify sourced from claude-restore, the same contract
# tmux-resurrect restores rely on. Titles are captured BEFORE exiting claude,
# because the shell may rewrite the title once claude is gone.
#
# After the restart, sweep TCC (privacy) rows orphaned by the version the panes
# just left. claude-tcc-prune spares any version a running process still holds,
# so those rows only become collectable once the old-version panes have exited.
# Panes left on the old version (skipped or failed) keep their row. This is the
# only call site that can do the sweep: it needs Full Disk Access, which belongs
# to the responsible process, and under Raycast that is Raycast.
#
# Per-pane detail goes to a log file as well as stdout, because Raycast compact
# mode shows only the final summary line - which is where a failure's cause used
# to disappear.

set -euo pipefail

# Raycast runs script commands with a minimal PATH that has neither
# ~/.local/bin (claude-restore) nor /opt/homebrew/bin (tmux). Append rather
# than prepend so a caller-provided override still wins.
PATH="$PATH:$HOME/.local/bin:/opt/homebrew/bin"

# How long to wait for a pane's claude to exit before giving up on it, and how
# often to poll. Exit keys are re-sent every reprompt_polls polls in case the
# first C-c pair landed outside claude's confirm-exit window.
#
# 30s, not 10s: a pane mid tool call doesn't exit on the first C-c (that only
# interrupts), and a pane sitting on a permission prompt spends a pair of keys
# dismissing it before the exit pair can land. A healthy pane exits in well
# under a second, so the larger budget is only ever spent on stuck panes.
# Overridable to keep the timeout branch testable without a 30s wait.
readonly exit_timeout="${CLAUDE_REFRESH_EXIT_TIMEOUT:-30}"
readonly poll_interval=0.2
readonly reprompt_polls=5

# Full detail for the LAST run only - truncated on each start, because the
# question it answers is always about the run that just happened.
readonly refresh_log="${CLAUDE_REFRESH_LOG:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-refresh.log}"

# Append one line to the log. Never fails the run: the log is a convenience, and
# an unwritable state dir must not take the refresh down with it.
claude_refresh_record() {
  printf '%s\n' "$1" >>"$refresh_log" 2>/dev/null || true
}

# Report a line on stdout and in the log.
claude_refresh_say() {
  printf '%s\n' "$1"
  claude_refresh_record "$1"
}

# Record what a stuck pane is showing, log only - it's many lines, and Raycast
# would not show them anyway. This is the whole reason the log exists: a pane
# that won't exit is nearly always sitting on a prompt, and its screen is the
# only thing that says which one.
claude_refresh_capture() {
  local pane="$1" capture line
  capture="$(tmux capture-pane -p -t "$pane" -S -40 2>/dev/null \
    | grep -vE '^[[:space:]]*$' | tail -12)" || true
  [ -n "$capture" ] || return 0
  claude_refresh_record "  --- $pane showing ---"
  while IFS= read -r line; do
    claude_refresh_record "  | $line"
  done <<<"$capture"
}

# The title parser lives in claude-restore (sourceable by design). Overridable
# so tests can point at a checkout instead of PATH.
CLAUDE_RESTORE_BIN="${CLAUDE_RESTORE_BIN:-$(command -v claude-restore || true)}"
if [ -z "$CLAUDE_RESTORE_BIN" ]; then
  echo "claude-refresh: claude-restore not found on PATH (provides the title parser)" >&2
  return 1 2>/dev/null || exit 1
fi
# shellcheck source=/dev/null
source "$CLAUDE_RESTORE_BIN"

# Map raw pane listings to refresh actions. Reads
# `pane_id<TAB>command<TAB>cwd<TAB>title` lines on stdin ($1 = the invoking
# pane's id, may be empty) and emits one action line per claude pane:
#   restart<TAB><pane_id><TAB><session-name>
#   skip-self<TAB><pane_id>
#   skip-cwd<TAB><pane_id><TAB><cwd>
#   skip-unnamed<TAB><pane_id><TAB><title>
# Non-claude panes emit nothing. Reads the filesystem (-d) but never writes;
# sourceable for tests.
claude_refresh_plan() {
  local self="${1:-}"
  local pane cmd cwd title action
  while IFS=$'\t' read -r pane cmd cwd title; do
    [ -n "$pane" ] || continue
    [ "$cmd" = claude ] || continue
    if [ -n "$self" ] && [ "$pane" = "$self" ]; then
      printf 'skip-self\t%s\n' "$pane"
      continue
    fi
    # A deleted cwd (removed worktree) keeps the running claude alive but makes
    # it unresumable: the shell can't start anything from a directory that no
    # longer exists. Exiting claude here would strand the pane, so leave it.
    if [ ! -d "$cwd" ]; then
      printf 'skip-cwd\t%s\t%s\n' "$pane" "$cwd"
      continue
    fi
    action="$(claude_restore_classify "$title")"
    case "$action" in
      resume$'\t'*)
        printf 'restart\t%s\t%s\n' "$pane" "${action#resume$'\t'}"
        ;;
      *)
        printf 'skip-unnamed\t%s\t%s\n' "$pane" "$title"
        ;;
    esac
  done
}

# Wait for one pane's claude to exit, re-sending the exit keys periodically.
# Echoes the terminal state: ok | timeout | vanished.
claude_refresh_await_shell() {
  local pane="$1"
  local deadline=$((SECONDS + exit_timeout)) polls=0 current
  while :; do
    current="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
    if [ -z "$current" ]; then
      echo vanished
      return 0
    fi
    if [ "$current" != claude ]; then
      echo ok
      return 0
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo timeout
      return 0
    fi
    polls=$((polls + 1))
    if [ $((polls % reprompt_polls)) -eq 0 ]; then
      # || true: the pane can close between the probe above and this send;
      # the next probe reports it as vanished.
      tmux send-keys -t "$pane" C-c C-c 2>/dev/null || true
    fi
    sleep "$poll_interval"
  done
}

claude_refresh_main() {
  mkdir -p "$(dirname "$refresh_log")" 2>/dev/null || true
  : >"$refresh_log" 2>/dev/null || true
  claude_refresh_record "claude-refresh $(date '+%Y-%m-%d %H:%M:%S')"

  local listing
  if ! listing="$(tmux list-panes -a -F $'#{pane_id}\t#{pane_current_command}\t#{pane_current_path}\t#{pane_title}' 2>/dev/null)"; then
    echo "claude-refresh: tmux not available or no server running" >&2
    exit 1
  fi

  local plan
  plan="$(printf '%s\n' "$listing" | claude_refresh_plan "${TMUX_PANE:-}")"

  local -a panes=() names=()
  local action pane detail skipped=0
  while IFS=$'\t' read -r action pane detail; do
    case "$action" in
      restart)
        panes+=("$pane")
        names+=("$detail")
        ;;
      skip-self)
        claude_refresh_say "skip      $pane  (this pane is running the refresh)"
        ;;
      skip-cwd)
        claude_refresh_say "skip      $pane  cwd no longer exists ($detail) - restarting would strand the pane"
        skipped=$((skipped + 1))
        ;;
      skip-unnamed)
        claude_refresh_say "skip      $pane  unnamed session (title: ${detail:-<empty>})"
        skipped=$((skipped + 1))
        ;;
    esac
  done <<<"$plan"

  if [ "${#panes[@]}" -eq 0 ]; then
    claude_refresh_say "No claude panes to restart."
    return 0
  fi

  # Exit all panes first, then poll each, so slow exits overlap instead of
  # serializing.
  local i
  for i in "${!panes[@]}"; do
    # || true: a pane that closed since the plan snapshot must not abort the
    # blast (set -e) - phase 2 reports it as vanished.
    tmux send-keys -t "${panes[$i]}" C-c C-c 2>/dev/null || true
  done

  local state resume_cmd restarted=0 failed=0
  for i in "${!panes[@]}"; do
    pane="${panes[$i]}"
    state="$(claude_refresh_await_shell "$pane")"
    case "$state" in
      ok)
        # -l types the command literally (no key-name interpretation); %q keeps
        # names with spaces one argument for the pane's shell.
        printf -v resume_cmd 'claude -r %q' "${names[$i]}"
        if tmux send-keys -t "$pane" -l "$resume_cmd" 2>/dev/null \
          && tmux send-keys -t "$pane" Enter 2>/dev/null; then
          claude_refresh_say "restarted $pane  ${names[$i]}"
          restarted=$((restarted + 1))
        else
          claude_refresh_say "FAILED    $pane  ${names[$i]} (pane disappeared mid-refresh)"
          failed=$((failed + 1))
        fi
        ;;
      timeout)
        claude_refresh_say "FAILED    $pane  ${names[$i]} (claude didn't exit within ${exit_timeout}s, left as is)"
        claude_refresh_capture "$pane"
        failed=$((failed + 1))
        ;;
      vanished)
        claude_refresh_say "FAILED    $pane  ${names[$i]} (pane disappeared mid-refresh)"
        failed=$((failed + 1))
        ;;
    esac
  done

  # Last line is the summary - Raycast compact mode shows only this, so when
  # anything went wrong it has to carry the pointer to where the detail is.
  local summary="Restarted $restarted, skipped $skipped, failed $failed."
  if [ "$failed" -gt 0 ] || [ "$skipped" -gt 0 ]; then
    summary="$summary Detail: $refresh_log"
  fi
  claude_refresh_say "$summary"
  [ "$failed" -eq 0 ]
}

# Run only when executed directly - sourcing (e.g. from tests) just defines the
# functions above.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  # `|| refresh_status=$?` puts the whole of claude_refresh_main in a tested
  # context, which suspends errexit inside it. That is acceptable here because
  # every command in the function that can fail is already guarded
  # individually, and it keeps the tmux-unavailable path exiting 1 without
  # pruning. Don't replace it with an EXIT trap without re-checking both.
  refresh_status=0
  claude_refresh_main "$@" || refresh_status=$?
  # Prune now that the old-version processes are gone. A prune failure (no Full
  # Disk Access is the usual one) must not mask the refresh's own exit status.
  #
  # Output goes to stderr so the refresh summary stays the last line on stdout,
  # which is all Raycast compact mode shows. `--quiet` still prints when it
  # actually removes rows, by design, and that is the case this call exists for.
  if command -v claude-tcc-prune >/dev/null 2>&1; then
    claude-tcc-prune --quiet >&2 || true
  fi
  exit "$refresh_status"
fi
