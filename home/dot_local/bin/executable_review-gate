#!/usr/bin/env bash
# Refuses Claude's commits and pushes that no review covers.
#
#   review-gate mark [--branch] <triage file>   record a review of the staged
#                                               tree (--branch: of the whole
#                                               branch, plus any staged fixes)
#   review-gate defer "<reason>"                let a commit of the staged tree
#                                               through unreviewed; push checks it
#   review-gate last                            print the newest commit in HEAD's
#                                               history a branch review covered
#   review-gate pre-commit                      git hook (global git config)
#   review-gate pre-push <remote> <url>         git hook (global git config)
#
# A review is recorded as the hash of the exact tree it approved, so any later
# edit needs a new review. The log lives in the git common dir, shared by all
# worktrees and never tracked.
#
# The hooks gate only commands run by Claude Code (CLAUDECODE=1), and only in
# repos with a remote; `git config claude.reviewHook true` opts a repo in and
# `false` opts it out. A branch's first push needs a branch review of HEAD, so
# every PR gets one branch review. Later pushes need each new commit covered by
# reviews that chain from its parent's tree to its own (so an amend or squash
# whose reviews don't chain back to its new parent isn't covered), or by a
# branch review of it or a commit built on it. Tag pushes aren't checked; the
# push prompt still covers them.

set -euo pipefail

die() {
  printf 'review-gate: %s\n' "$*" >&2
  exit 1
}

log_file() {
  printf '%s/claude-reviews.log' "$(git rev-parse --path-format=absolute --git-common-dir)"
}

EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904

# Log line: tree, kind, time, branch, note (triage path or reason), base,
# head. The base is HEAD's tree when the review ran (a commit review saw only
# the change from its base to its tree); the head is HEAD's commit then (a
# branch review saw that commit's history plus what was staged).
record() {
  local tree="$1" kind="$2" note="${3//[$'\t\n']/ }" branch base head
  branch=$(git branch --show-current)
  base=$(git rev-parse -q --verify 'HEAD^{tree}' || printf '%s' "$EMPTY_TREE")
  head=$(git rev-parse -q --verify HEAD || printf none)
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$tree" "$kind" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "${branch:-detached}" "$note" "$base" "$head" >>"$(log_file)"
}

# branch_covered <commit>: a branch review ran on this commit, or on its
# parent with this commit's tree staged (the review's fixes, committed after),
# or on a commit with the same tree and parent (an amend that only rewords
# it). A later commit that only repeats the tree, as a revert can, isn't.
branch_covered() {
  local sha="$1" tree parent log head
  log=$(log_file)
  [ -f "$log" ] || return 1
  tree=$(git rev-parse "$sha^{tree}")
  parent=$(git rev-parse -q --verify "$sha^" || printf none)
  # Read to the end: `grep -q` exiting early can kill the writer, and
  # pipefail would then report a match as a failure.
  while read -r head; do
    [ "$head" = "$sha" ] || [ "$head" = "$parent" ] && return 0
    [ "$(git rev-parse -q --verify "$head^" || printf none)" = "$parent" ] \
      && [ "$(git rev-parse -q --verify "$head^{tree}" || true)" = "$tree" ] && return 0
  done < <(grep -E "^$tree	branch	" "$log" | cut -f7 | sort -u || true)
  return 1
}

# has_record <tree> <kind regex>
has_record() {
  local log
  log=$(log_file)
  # Not `grep -q`: an early exit can kill `cut`, and pipefail would then
  # report a match as a failure.
  [ -f "$log" ] && cut -f1,2 "$log" | grep -E "^$1	($2)\$" >/dev/null
}

# commit_covered <tree> <parent tree>: a chain of commit reviews runs from
# the parent's tree to this tree, so every change between them was reviewed.
# An amend or squash keeps its tree but can change its parent, so the tree
# alone isn't enough.
commit_covered() {
  local tree="$1" parent="$2" log base
  [ "$tree" = "$parent" ] && return 0
  # Trees already checked on this walk; a change and its revert can both be
  # reviewed, which makes a cycle.
  case " ${visited:-} " in *" $tree "*) return 1 ;; esac
  visited="${visited:-} $tree"
  log=$(log_file)
  [ -f "$log" ] || return 1
  while read -r base; do
    [ -n "$base" ] || continue
    commit_covered "$base" "$parent" && return 0
  done < <(grep -E "^$tree	commit	" "$log" | cut -f6 | sort -u || true)
  return 1
}

gate_active() {
  [ "${CLAUDECODE:-}" = 1 ] || return 1
  local setting
  if ! setting=$(git config --type=bool --get claude.reviewHook); then
    # Exit 1 means unset; anything else is a value git can't read as a bool.
    [ -z "$(git config --get claude.reviewHook)" ] \
      || die "claude.reviewHook must be true or false"
  fi
  case "$setting" in
    true) return 0 ;;
    false) return 1 ;;
  esac
  [ -n "$(git remote)" ]
}

# A triage file /review wrote for this branch: <timestamp>-<branch>-triage.md
# in .reviews/code/ at the root of any worktree of this repo, or of the folder
# holding the git dir (the main checkout, or a bare-repo workspace).
check_triage_file() {
  local file="$1" dir branch root found=false
  [ -f "$file" ] || die "triage file not found: $file"
  dir=$(cd "$(dirname "$file")" && pwd -P)
  branch=$(git branch --show-current)
  [ -n "$branch" ] || die "HEAD is detached; check out the reviewed branch first"
  while read -r root; do
    [ -d "$root/.reviews/code" ] || continue
    [ "$(cd "$root/.reviews/code" && pwd -P)" = "$dir" ] && found=true
  done < <(
    dirname "$(git rev-parse --path-format=absolute --git-common-dir)"
    git rev-parse --show-toplevel
    git worktree list --porcelain | sed -n 's/^worktree //p'
  )
  [ "$found" = true ] || die "triage file must be in the repo's .reviews/code/: $file"
  # The whole slug must match, so feat/x doesn't accept chore/feat-x's file.
  [[ "$(basename "$file")" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}-(.+)-triage\.md$ ]] \
    && [ "${BASH_REMATCH[1]}" = "${branch//\//-}" ] \
    || die "triage file must be this branch's (<timestamp>-${branch//\//-}-triage.md): $file"
}

cmd_mark() {
  local kind=commit tree
  if [ "${1:-}" = --branch ]; then
    kind=branch
    shift
  fi
  [ $# -eq 1 ] || die "usage: review-gate mark [--branch] <triage file>"
  check_triage_file "$1"
  local triage log
  triage="$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"
  log=$(log_file)
  # One triage file per review run: reusing an old one would record edits
  # made after that review.
  if [ -f "$log" ] && cut -f5 "$log" | grep -Fx "$triage" >/dev/null; then
    die "this triage file already recorded a review; run /review again for the current changes"
  fi
  # The staged tree in both kinds: a branch review's staged fixes are part of
  # what it approved, and with nothing staged this is HEAD's tree.
  tree=$(git write-tree)
  record "$tree" "$kind" "$triage"
  printf 'Recorded %s review of tree %s\n' "$kind" "${tree:0:12}"
}

# Only a branch review covers every commit it is built on, so a review of the
# commits after this one plus this record covers the whole branch.
cmd_last() {
  local ref="${1:-HEAD}" log reviewed sha tree
  log=$(log_file)
  [ -f "$log" ] || return 0
  reviewed=$(grep -E '^[0-9a-f]+	branch	' "$log" | cut -f1 | sort -u || true)
  [ -n "$reviewed" ] || return 0
  while read -r sha tree; do
    if grep -qx "$tree" <<<"$reviewed" && branch_covered "$sha"; then
      printf '%s\n' "$sha"
      return
    fi
  done < <(git log --max-count=500 --format='%H %T' "$ref" 2>/dev/null)
}

# The review that covers <ref>'s unpushed commits at its next push: a branch
# with no upstream, or with no branch review in its history, needs a review
# of the whole branch; otherwise reviewing from the last one is enough.
next_review() {
  local ref="${1:-HEAD}" pushed_before="${2:-}" branch
  if [ -z "$pushed_before" ]; then
    branch=$(git rev-parse --abbrev-ref "$ref" 2>/dev/null || true)
    # A detached HEAD names no branch; refs/remotes/*/HEAD would match.
    [ "$branch" = HEAD ] && branch=""
    if git rev-parse -q --verify "$ref@{upstream}" >/dev/null 2>&1 \
      || { [ -n "$branch" ] && [ -n "$(git for-each-ref --format=x "refs/remotes/*/$branch")" ]; }; then
      pushed_before=yes
    fi
  fi
  if [ -n "$pushed_before" ] && [ -n "$(cmd_last "$ref")" ]; then
    printf '/review unreviewed'
  else
    printf '/review branch'
  fi
}

cmd_defer() {
  [ -n "${*// /}" ] || die 'usage: review-gate defer "<reason>"'
  record "$(git write-tree)" defer "$*"
  printf 'Deferred review of the staged changes. Before you push, run %s and commit any fixes it stages.\n' "$(next_review)"
}

cmd_pre_commit() {
  gate_active || exit 0
  # GIT_INDEX_FILE points at the index being committed, so `commit -a` and
  # `commit <paths>` are checked as committed, not as staged.
  local tree head_tree
  tree=$(git write-tree)
  head_tree=$(git rev-parse -q --verify 'HEAD^{tree}' || true)
  [ "$tree" = "$head_tree" ] && exit 0
  has_record "$tree" 'commit|branch|defer' && exit 0
  cat >&2 <<'EOF'
review-gate: no review covers this commit. Stage everything you mean to
commit (no -a or paths), then either:
  - run /review, then commit again, or
  - for an end-of-PR commit or a trivial change, run
    review-gate defer "<reason>", then commit again; its output names the
    review to run before you push.
If you ran this yourself outside Claude Code, Claude Code's environment
leaked into this shell, for example from a tmux server a Claude session
started; restart that tmux server or use a terminal outside it.
EOF
  exit 1
}

cmd_pre_push() {
  gate_active || exit 0
  local zero=0000000000000000000000000000000000000000
  local local_ref local_sha remote_ref remote_sha new sha pushed=HEAD
  local -a uncovered=()
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    [[ "$remote_ref" == refs/heads/* ]] || continue
    pushed="$local_ref"
    new=$(git rev-list "$local_sha" --not --remotes)
    [ -n "$new" ] || continue

    if [ "$remote_sha" = "$zero" ] && ! branch_covered "$local_sha"; then
      printf 'review-gate: the first push of %s needs a review of the whole branch.\nRun /review branch, commit any fixes it stages, then push again.\n' \
        "${remote_ref#refs/heads/}" >&2
      exit 1
    fi

    # A branch review covers its commit and every commit it is built on.
    local -a branch_reviewed=()
    for sha in $new; do
      branch_covered "$sha" && branch_reviewed+=("^$sha")
    done
    # The ^exclusions go before --not, which would flip them into inclusions.
    # Assigned first so a rev-list failure stops the push (set -e).
    new=$(git rev-list "$local_sha" ${branch_reviewed[@]+"${branch_reviewed[@]}"} --not --remotes)
    for sha in $new; do
      local tree parent_tree
      tree=$(git rev-parse "$sha^{tree}")
      parent_tree=$(git rev-parse -q --verify "$sha^^{tree}" || printf '%s' "$EMPTY_TREE")
      visited="" commit_covered "$tree" "$parent_tree" && continue
      uncovered+=("$(git log -1 --format='%h %s' "$sha")")
    done
  done

  if [ ${#uncovered[@]} -gt 0 ]; then
    {
      echo "review-gate: no review covers these commits:"
      printf '  %s\n' "${uncovered[@]}"
      # A later push: the first-push check above already passed.
      echo "Run $(next_review "$pushed" yes), commit any fixes it stages, then push again."
    } >&2
    exit 1
  fi
}

case "${1:-}" in
  mark) shift && cmd_mark "$@" ;;
  defer) shift && cmd_defer "$@" ;;
  last) cmd_last ;;
  pre-commit) cmd_pre_commit ;;
  pre-push) cmd_pre_push ;;
  *) die 'usage: review-gate mark [--branch] <triage file> | defer "<reason>" | last | pre-commit | pre-push' ;;
esac
