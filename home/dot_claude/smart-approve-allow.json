      "Bash(git -C * diff *)",
      "Bash(git -C * diff)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * grep *)",
      "Bash(git -C * grep)",
      "Bash(git -C * log *)",
      "Bash(git -C * log)",
      "Bash(git -C * ls-files *)",
      "Bash(git -C * ls-tree *)",
      "Bash(git -C * mv *)",
      "Bash(git -C * pull *)",
      "Bash(git -C * reflog *)",
      "Bash(git -C * remote -v)",
      "Bash(git -C * remote get-url *)",
      "Bash(git -C * reset HEAD *)",
      "Bash(git -C * restore *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * rm *)",
